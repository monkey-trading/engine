# Options the enclave guest needs on top of x86_64_defconfig. The image build fails if any line
# here does not hold in the final kernel config.

# Everything the guest runs is in the measured kernel: no loadable modules.
# CONFIG_MODULES is not set

# AMD SEV-SNP guest, and attestation reports through configfs-tsm.
CONFIG_AMD_MEM_ENCRYPT=y
CONFIG_VIRT_DRIVERS=y
CONFIG_SEV_GUEST=y
CONFIG_TSM_REPORTS=y
CONFIG_CONFIGFS_FS=y
CONFIG_X86_X2APIC=y
CONFIG_KVM_GUEST=y

# Direct boot from OVMF with an initramfs, the host's data disk, and DHCP on the virtio NIC.
CONFIG_EFI_STUB=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_EXT4_FS=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y

# No debug entry points the host could drive over the serial console.
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_KGDB is not set

# No drivers for devices the image does not use, so a device the host attaches finds none.
# CONFIG_USB_SUPPORT is not set
# CONFIG_ATA is not set
# CONFIG_SCSI is not set
# CONFIG_SOUND is not set
# CONFIG_DRM is not set
# CONFIG_AGP is not set
# CONFIG_HOTPLUG_PCI is not set
# CONFIG_PCCARD is not set
# CONFIG_ETHERNET is not set
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_NET_9P is not set
# CONFIG_VIRTIO_CONSOLE is not set
# CONFIG_HW_RANDOM is not set

# No keyboard, mouse, or virtual terminal: the serial console only writes. EXPERT makes them
# switchable; it changes no default.
CONFIG_EXPERT=y
# CONFIG_VT is not set
# CONFIG_SERIO is not set
# CONFIG_INPUT is not set
